# Kooks settings for the browser server (web/server.js) and the MCP server
# (mcp/index.js). Kooks reads environment variables only; it does not load
# this file. Copy it to .env (ignored by Git), uncomment what you need, and
# pass it with `node --env-file=.env web/server.js`, `docker run --env-file`
# or your host's environment settings. Keep real values out of Git.
#
# Leave a line commented to use its default: an empty value is not the same
# as an unset one.

# --- Server -----------------------------------------------------------------

# Interface to listen on. Any address other than 127.0.0.1, localhost or ::1
# turns household sign-in on and needs KOOKS_PUBLIC_ORIGIN. The Docker image
# sets 0.0.0.0.
# KOOKS_HOST=127.0.0.1

# Port for the browser app. The Docker image sets 4317.
# PORT=4317

# SQLite database shared by the browser and MCP servers. Relative paths are
# resolved from the working directory. Default: .data/kooks.sqlite in the
# checkout; the Docker image sets /data/kooks.sqlite.
# KOOKS_DB_PATH=.data/kooks.sqlite

# --- Household sign-in (docs/hosting.md, docs/household-features.md) --------

# The exact address members open: an HTTPS origin for a hosted service, or a
# plain-HTTP address on a private network such as http://192.168.1.20:4317.
# Passkeys are bound to its host name, sign-in links point to it, and requests
# naming any other host are refused. Required beyond loopback; setting it
# turns sign-in on.
# KOOKS_PUBLIC_ORIGIN=https://kooks.example.com

# Addresses allowed to sign in, separated by commas. Setting any turns
# sign-in on, even on loopback.
# KOOKS_HOUSEHOLD_EMAILS=ada@example.com, sam@example.com

# --- Mail for sign-in links: set KOOKS_SMTP_HOST or KOOKS_MAIL_OUTBOX --------

# SMTP server that sends sign-in links.
# KOOKS_SMTP_HOST=smtp.example.com

# starttls (default, port 587), tls (encrypted from the first byte, port 465)
# or none (unencrypted, trusted private relay only, port 25).
# KOOKS_SMTP_SECURITY=starttls

# Defaults to the port for KOOKS_SMTP_SECURITY.
# KOOKS_SMTP_PORT=587

# Leave both unset for a relay that needs no login. Keep the password in your
# deployment's secret store.
# KOOKS_SMTP_USER=kooks@example.com
# KOOKS_SMTP_PASSWORD=

# Sender of sign-in links. Optional when KOOKS_SMTP_USER is an address.
# KOOKS_MAIL_FROM=Kooks <kooks@example.com>

# Development only: write each sign-in email to a file in this directory
# instead of sending it. Cannot be combined with KOOKS_SMTP_HOST.
# KOOKS_MAIL_OUTBOX=.data/outbox

# --- The assistant (docs/hosting.md) -----------------------------------------

# A Claude API key turns Ask Kooks on. Members' questions, and the recipes and
# household details the assistant reads to answer them, go to Anthropic. Only
# this variable is read; ANTHROPIC_API_KEY and the SDK's other settings are
# ignored. Keep it in your deployment's secret store.
# KOOKS_ANTHROPIC_API_KEY=

# Tokens the kitchen may spend in a day; cache reads count a tenth.
# KOOKS_ASSISTANT_DAILY_TOKENS=2000000

# The Claude model the assistant uses. Another model must take adaptive
# thinking, effort and server-side fallback, as the default does.
# KOOKS_ASSISTANT_MODEL=claude-opus-5-5

# --- Photo imports -----------------------------------------------------------

# Where the macOS OCR helper is compiled and cached. Default:
# ~/Library/Caches/kooks on macOS, kooks-cache in the temporary directory
# elsewhere.
# KOOKS_CACHE_DIR=/path/to/cache

# --- Tests ------------------------------------------------------------------

# Set to 1 to include the real local OCR test in `npm test`.
# KOOKS_TEST_OCR=1

# KOOKS_ACCESS_TOKEN and KOOKS_ACCESS_TOKEN_FILE are no longer used; the
# server refuses to start while either is set.
