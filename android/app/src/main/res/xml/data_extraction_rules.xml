<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: device backup and moving to a new phone keep the
     cookbook (the kooks folder app/storage.js writes) and nothing else. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="kooks" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="kooks" />
    </device-transfer>
</data-extraction-rules>
