{
  "name": "kooks-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Local MCP tools for the Kooks household cooking workflow",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node mcp/index.js",
    "dev": "node web/server.js",
    "web": "node web/server.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node -e \"fs.mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.js",
    "dev:client": "vite --config client/vite.config.js",
    "build:client": "vite build --config client/vite.config.js",
    "cap:sync": "npm run build:client && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:run:ios": "npm run cap:sync && cap run ios",
    "cap:run:android": "npm run cap:sync && cap run android",
    "build:android": "npm run cap:sync && node scripts/native-build.mjs android",
    "build:ios": "npm run cap:sync && node scripts/native-build.mjs ios",
    "native:doctor": "node scripts/native-build.mjs doctor",
    "native:assets": "node scripts/native-assets.mjs",
    "native:version": "node scripts/native-version.mjs",
    "version": "node scripts/native-version.mjs && git add android/app/build.gradle ios/App/App.xcodeproj/project.pbxproj",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:web:e2e": "playwright test --project web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.63.0",
    "@preact/signals": "^2.11.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lucide": "^1.47.0",
    "preact": "^11.1.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.5",
    "vite": "^8.3.5"
  }
}
